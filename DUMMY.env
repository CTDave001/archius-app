# Copy this file to .env (or .env.local) and fill in real values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the client app.
# Variables without that prefix are server-only (Expo Router API routes).

# --- Client (safe to bundle) ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
EXPO_PUBLIC_RC_APPLE_KEY=appl_
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_
# Optional: override the API base URL (defaults to the dev server host)
# EXPO_PUBLIC_API_URL=https://api.archius.app

# --- Server-only (NEVER prefix these with EXPO_PUBLIC_) ---
DEEPSEEK_API_KEY=sk-
CLERK_SECRET_KEY=sk_test_
