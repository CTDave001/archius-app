# Copy this file to .env (or .env.local) and fill in real values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the client app.
# Variables without that prefix are server-only (Expo Router API routes).

# --- Client (safe to bundle) ---
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
EXPO_PUBLIC_RC_APPLE_KEY=appl_
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_
EXPO_PUBLIC_RC_WEB_KEY=rcb_
# Optional RevenueCat customer-portal URL for web subscription management.
# EXPO_PUBLIC_RC_CUSTOMER_PORTAL_URL=https://...
# Required in standalone builds; local development defaults to the Metro host
# EXPO_PUBLIC_API_URL=https://api.archius.app

# --- Server-only (NEVER prefix these with EXPO_PUBLIC_) ---
DEEPSEEK_API_KEY=sk-
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash
TAVILY_API_KEY=tvly-
CLERK_SECRET_KEY=sk_test_
REVENUECAT_SECRET_KEY=sk_
REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-value
# Managed Postgres used by authenticated web chat sync.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
REVIEW_DEMO_EMAIL=appreview@archius.app
HEALTH_CHECK_TOKEN=replace-with-a-long-random-value
